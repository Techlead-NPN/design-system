{
  "name": "@techlead-npn/design-system",
  "version": "0.4.0",
  "description": "Coded React + Tailwind v4 components and design tokens for Techlead projects.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Techlead-NPN/design-system.git",
    "directory": "components"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens/*": "./dist/tokens/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-tokens.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/react-vite": "^10.6.1",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.3"
  }
}
